{
  "name": "cynex-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cynex frontend: TypeScript schema/digest mirror of the frozen contract API (cynex-v1.0.0)",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "near-api-js": "^7.0.0",
    "near-kit": "^0.20.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "conformance": "tsc && node dist/scripts/conformance.js",
    "typecheck": "tsc --noEmit",
    "jest": "NODE_OPTIONS=--experimental-vm-modules npx jest --roots src ../services --runInBand",
    "jest:sandbox": "CYNEX_SANDBOX_TESTS=1 NODE_OPTIONS=--experimental-vm-modules npx jest --roots src ../services --runInBand \"services/mcp/(sandbox|demo)\"",
    "mcp:build": "npx tsc -p tsconfig.mcp.json",
    "mcp": "node dist-test/services/mcp/server.js",
    "mcp:test-client": "node dist-test/services/mcp/test-client.js",
    "mcp:demo": "node dist-test/services/mcp/demo.js",
    "mcp:cli": "node dist-test/services/mcp/cli.js"
  }
}
