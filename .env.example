# Cynex environment configuration.
# Copy this file to .env and fill in your own values.
# Never commit a real .env file. Key files stay outside the repo.
# All values below are placeholders or public testnet defaults.

# NEAR network and accounts (testnet)
CYNEX_RPC_URL=https://rpc.testnet.fastnear.com
CYNEX_VAULT=cynex-testvault.cynexmaster.testnet
CYNEX_OWNER=cynexmaster.testnet
CYNEX_AGENT=cynex-agent.cynexmaster.testnet

# Key files. Each holds a bare key string or a NEAR credentials JSON
# object (account_id, public_key, private_key). They live outside the
# repo, never in it, and are never printed or logged.
CYNEX_OWNER_KEY_FILE=/path/to/owner-key.json
CYNEX_AGENT_KEY_FILE=/path/to/agent-key.json

# Verifier evidence path only
CYNEX_VERIFIER=<verifier-account>
CYNEX_VERIFIER_KEY_FILE=/path/to/verifier-key.json

# Console inputs
CYNEX_OBLIGATION_FILE=/path/to/obligation.json
CYNEX_ARTIFACT_FILE=/path/to/artifact.bin

# Set to 1 only when the owner explicitly approves a WARN verdict.
CYNEX_APPROVE_WARN=0

# MCP server
CYNEX_SNAPSHOT_DIR=/path/to/reputation-snapshots
CYNEX_BLOCKLIST_URL=
CYNEX_NEARBLOCKS_URL=https://api-testnet.nearblocks.io

# Executor (local only)
CYNEX_EXECUTOR_HOST=127.0.0.1
CYNEX_EXECUTOR_PORT=8787
CYNEX_EXECUTOR_TOKEN=

# Sandbox demo (local only, no testnet)
# Set exactly one of CYNEX_RPC_URL (above) and CYNEX_SANDBOX_RPC_URL; setting both breaks MCP startup.
# CYNEX_SANDBOX_RPC_URL=http://127.0.0.1:3030
# The live sandbox chain id is test-chain-<suffix>; the code default is "sandbox".
# Leave the chain id commented out too: setting it without CYNEX_SANDBOX_RPC_URL also breaks MCP startup.
# CYNEX_SANDBOX_CHAIN_ID=sandbox
